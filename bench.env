# Settings for scripts/. Precedence: environment variables, then bench.local.env (git-ignored, per machine), then
# the defaults below. Example: NES_THREADS=1 scripts/nes/run-query.sh ...

# NES fork and build
: "${NES_REPO:=$HOME/nes}"
: "${NES_BUILD:=$NES_REPO/build-docker-release}"   # matches /build-docker* in the NES .gitignore
: "${NES_BUILD_TYPE:=Release}"
: "${NES_CMAKE_ARGS:=}"
: "${NES_JOBS:=$(nproc)}"
: "${NES_WORKER_BIN:=$NES_BUILD/nes-single-node-worker/nes-single-node-worker}"
: "${NES_CLI_BIN:=$NES_BUILD/nes-frontend/apps/nes-cli}"
# Native mode (no Docker, e.g. no root on the machine): worker and CLI from a bundle made by scripts/nes/bundle.sh.
# DOCKER_CPUSET then pins via taskset; DOCKER_MEMORY etc. do not apply.
: "${NES_NATIVE:=0}"
: "${NES_BUNDLE:=$HOME/nes-bundle}"
if [[ "$NES_NATIVE" == 1 ]]; then
  NES_BUILD="$NES_BUNDLE"
  NES_WORKER_BIN="$NES_BUNDLE/nes-single-node-worker"
  NES_CLI_BIN="$NES_BUNDLE/nes-cli"
fi

# Benchmark data: inputs and caches (raw scenes, stores, references); mounted into the container at the same path
: "${DATA:=$BENCH_REPO/data}"
# One result set: correctness reports, NES run records, perf runs, perf.csv, report, provenance. Rerunning with the
# same label resumes it. Example: RUN_LABEL=vm-final scripts/performance.sh -> data/results/vm-final
: "${RUN_LABEL:=$(hostname -s 2>/dev/null || hostname)}"
: "${RESULTS:=$DATA/results/$RUN_LABEL}"

# Worker: buffer pool in 4 KiB buffers (1048576 = 4 GiB; one S2 frame needs ~390 MiB), threads, extra flags.
# NES_MAX_INFLIGHT bounds how far the source reads ahead: one source buffer holds up to 128 maplets
# (S2: ~256 MiB, allocated outside the pool), so the NES default of 64 allows ~16 GiB in flight.
: "${NES_POOL_BUFFERS:=1048576}"
: "${NES_THREADS:=4}"
: "${NES_MAX_INFLIGHT:=4}"
: "${NES_WORKER_ARGS:=}"
: "${NES_TIMEOUT_S:=3600}"
: "${NES_POLL_S:=1}"
: "${NES_SAMPLE_MS:=100}"                           # resource sampler interval (RSS, CPU) of the worker

# Docker
: "${DOCKER_IMAGE:=nebulastream/nes-development:local}"
# Container limits (docker run --memory / --memory-swap / --cpuset-cpus); empty = no limit.
# Set DOCKER_MEMORY_SWAP equal to DOCKER_MEMORY to forbid swapping. Docker Desktop's own VM limit is a GUI setting.
: "${DOCKER_MEMORY:=}"
: "${DOCKER_MEMORY_SWAP:=}"
: "${DOCKER_CPUSET:=}"
: "${DOCKER_USER:=$(id -u):$(id -g)}"
# Additional mounts "src:dst ...", e.g. a CLion build configured under /tmp:
# DOCKER_EXTRA_MOUNTS="$NES_REPO:/tmp/nebulastream-BA-streaming-map-algebra"
: "${DOCKER_EXTRA_MOUNTS:=}"

# GeoTrellis: threads of the full-grid reference (correctness, untimed; stripes of 256 rows when > 1). Perf runs use
# GT_THREADS, default PERF_THREADS (scripts/perf/run.sh), so NES and GeoTrellis get the same thread count.
: "${GT_REF_THREADS:=$(nproc)}"
# GeoTrellis JVM heap (-Xms = -Xmx, perf runs and the reference): G8 holds up to 16 frames per window (~390 MB each)
: "${GT_HEAP:=12g}"
export GT_HEAP

# Sentinel-2 evaluation data (scripts/data, scripts/correctness.sh, scripts/performance.sh)
: "${S2_NAME:=s2-berlin}"                       # raw scenes in $DATA/raw/$S2_NAME, stores $DATA/stores/$S2_NAME-<frames>
: "${S2_MGRS:=33UUU}"                           # MGRS tile (Berlin)
: "${S2_FROM:=2025-04-01}"
: "${S2_TO:=2025-09-30}"
: "${S2_MAXCLOUD:=15}"                          # max cloud cover, %
: "${S2_WINDOW:=13.10 52.65 13.65 52.38}"       # crop window, lon/lat: upper-left x y, lower-right x y
: "${S2_FRAMES:=16}"                            # correctness store: first N non-empty scenes (0 = all)
: "${S2_TILE:=256}"                             # tile size (suffix -t<size> in the store name unless 256)
: "${S2_HALO_TILE:=16}"                         # extra small-tile correctness store, for r > tile size
: "${S2_PERF_FRAMES:=$S2_FRAMES}"               # performance store: first N non-empty scenes

# Evaluation plan: case and grid IDs run by scripts/correctness.sh / scripts/performance.sh (definitions in
# scripts/correctness/cases.txt, scripts/perf/grids.txt, stores in scripts/data/stores.txt). Any subset, any time:
# finished runs of the same RUN_LABEL are skipped.
: "${CASES:=K1 K2 K3 K5 K6 K7 K8 K9 K10 K11 K12}"
: "${GRIDS:=G1 G2 G3 G4 G5 G6 G7 G8 G9}"
: "${FEATURES:=nes-pacing}"                     # optional capabilities: nes-pacing (NES build with the paced RasterFile source and the FrameLatency sink)
export FEATURES                                 # read by scripts/lib/plan.py (REQUIRES)
: "${REPS:=3}"
: "${NES_EVENT_TRACE:=0}"                       # 1: worker writes an event trace (operator time; overhead, grid G7)
