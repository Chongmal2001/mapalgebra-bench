# Settings for scripts/. Precedence: environment variables, then bench.local.env (git-ignored, per machine), then
# the defaults below. Example: NES_THREADS=1 scripts/nes/run-query.sh ...

# NES fork and build
: "${NES_REPO:=$HOME/nes}"
: "${NES_BUILD:=$NES_REPO/build-docker-release}"   # matches /build-docker* in the NES .gitignore
: "${NES_BUILD_TYPE:=Release}"
: "${NES_CMAKE_ARGS:=}"
: "${NES_JOBS:=$(nproc)}"
: "${NES_WORKER_BIN:=$NES_BUILD/nes-single-node-worker/nes-single-node-worker}"
: "${NES_CLI_BIN:=$NES_BUILD/nes-frontend/apps/nes-cli}"
# Native mode (no Docker, e.g. no root on the machine): worker and CLI from a bundle made by scripts/nes/bundle.sh.
# DOCKER_CPUSET then pins via taskset; DOCKER_MEMORY etc. do not apply.
: "${NES_NATIVE:=0}"
: "${NES_BUNDLE:=$HOME/nes-bundle}"
if [[ "$NES_NATIVE" == 1 ]]; then
  NES_BUILD="$NES_BUNDLE"
  NES_WORKER_BIN="$NES_BUNDLE/nes-single-node-worker"
  NES_CLI_BIN="$NES_BUNDLE/nes-cli"
fi

# Benchmark data (stores, refs, runs); mounted into the container at the same path
: "${DATA:=$BENCH_REPO/data}"

# Worker: buffer pool in 4 KiB buffers (1048576 = 4 GiB; one S2 frame needs ~390 MiB), threads, extra flags.
# NES_MAX_INFLIGHT bounds how far the source reads ahead: one source buffer holds up to 128 maplets
# (S2: ~256 MiB, allocated outside the pool), so the NES default of 64 allows ~16 GiB in flight.
: "${NES_POOL_BUFFERS:=1048576}"
: "${NES_THREADS:=4}"
: "${NES_MAX_INFLIGHT:=4}"
: "${NES_WORKER_ARGS:=}"
: "${NES_TIMEOUT_S:=3600}"
: "${NES_POLL_S:=1}"

# Docker
: "${DOCKER_IMAGE:=nebulastream/nes-development:local}"
# Container limits (docker run --memory / --memory-swap / --cpuset-cpus); empty = no limit.
# Set DOCKER_MEMORY_SWAP equal to DOCKER_MEMORY to forbid swapping. Docker Desktop's own VM limit is a GUI setting.
: "${DOCKER_MEMORY:=}"
: "${DOCKER_MEMORY_SWAP:=}"
: "${DOCKER_CPUSET:=}"
: "${DOCKER_USER:=$(id -u):$(id -g)}"
# Additional mounts "src:dst ...", e.g. a CLion build configured under /tmp:
# DOCKER_EXTRA_MOUNTS="$NES_REPO:/tmp/nebulastream-BA-streaming-map-algebra"
: "${DOCKER_EXTRA_MOUNTS:=}"
